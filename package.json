{
  "name": "@ideasonpurpose/wp-theme-addons",
  "version": "0.4.1",
  "description": "WordPress Block Editor add-ons — JavaScript blocks, utilities, and PHP components",
  "keywords": [
    "wordpress",
    "gutenberg",
    "block-editor",
    "block-variation",
    "themes"
  ],
  "homepage": "https://github.com/ideasonpurpose/wp-theme-addons",
  "bugs": {
    "url": "https://github.com/ideasonpurpose/wp-theme-addons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideasonpurpose/wp-theme-addons.git"
  },
  "license": "ISC",
  "author": "Ideas On Purpose (https://www.ideasonpurpose.com/)",
  "contributors": [
    {
      "name": "Joe Maller",
      "email": "joe@ideasonpurpose.com"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./carousel": {
      "types": "./frontend/carousel.d.ts",
      "default": "./frontend/carousel.js"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "editor",
    "frontend",
    "CssLocalProps",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/carousel.test.js",
    "version": "version-everything  && git add -u"
  },
  "prettier": "@ideasonpurpose/prettier-config",
  "stylelint": {
    "extends": "@ideasonpurpose/stylelint-config"
  },
  "devDependencies": {
    "@ideasonpurpose/prettier-config": "^1.1.1",
    "@ideasonpurpose/stylelint-config": "^1.1.7",
    "@prettier/plugin-php": "^0.26.0",
    "@types/wordpress__block-editor": "^15.0.9",
    "@wordpress/compose": "^8.10.0",
    "@wordpress/hooks": "^4.57.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "version-everything": "^0.12.2"
  },
  "version-everything": {
    "files": [
      "README.md"
    ],
    "prefix": "\"@ideasonpurpose/wp-theme-addons\": \"\\^"
  },
  "dependencies": {
    "embla-carousel": "9.0.0-rc04",
    "embla-carousel-accessibility": "9.0.0-rc04",
    "embla-carousel-autoplay": "9.0.0-rc04",
    "embla-carousel-class-names": "9.0.0-rc04"
  }
}
